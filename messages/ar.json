    "tagline": "\u062a\u062c\u0631\u0628\u0629 \u0642\u0631\u0627\u0621\u0629 \u0628\u0633\u064a\u0637\u0629 \u0648\u0628\u062f\u0648\u0646 \u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0645\u0635\u0645\u0645\u0629 \u0644\u0644\u062a\u0631\u0643\u064a\u0632 \u0648\u0627\u0644\u062a\u062f\u0628\u0631.",
    "whatIsThis": "\u0645\u0627 \u0647\u0630\u0627",
    "whatIsThisText": "\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0642\u0631\u0622\u0646 \u0647\u0648 \u0645\u0646\u0635\u0629 \u0646\u0638\u064a\u0641\u0629 \u0648\u062e\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u062a\u0634\u062a\u064a\u062a \u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645. \u0635\u064f\u0645\u0645 \u0628\u0628\u0633\u0627\u0637\u0629\u060c \u0648\u064a\u0648\u0641\u0631 \u062a\u062c\u0631\u0628\u0629 \u0642\u0631\u0627\u0621\u0629 \u0645\u0631\u0643\u0632\u0629 \u0628\u062f\u0648\u0646 \u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0623\u0648 \u0646\u0648\u0627\u0641\u0630 \u0645\u0646\u0628\u062b\u0642\u0629 \u0623\u0648 \u0645\u064a\u0632\u0627\u062a \u063a\u064a\u0631 \u0636\u0631\u0648\u0631\u064a\u0629.",
    "features": "\u0627\u0644\u0645\u064a\u0632\u0627\u062a",
    "feature1": "\u0627\u0644\u0642\u0631\u0622\u0646 \u0643\u0627\u0645\u0644\u0627\u064b \u0628\u0640 114 \u0633\u0648\u0631\u0629 \u0628\u0627\u0644\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a",
    "feature2": "\u0627\u0644\u0623\u0630\u0643\u0627\u0631 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u2014 \u0627\u0644\u0635\u0628\u0627\u062d \u0648\u0627\u0644\u0645\u0633\u0627\u0621 \u0648\u0627\u0644\u0646\u0648\u0645",
    "feature3": "\u0639\u0644\u0627\u0645\u0627\u062a \u0641\u0648\u0627\u0635\u0644 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u062a\u0642\u0644\u064a\u062f\u064a\u0629",
    "feature4": "\u062d\u062c\u0645 \u062e\u0637 \u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u0639\u062f\u064a\u0644 \u0648\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0642\u0631\u0627\u0621\u0629",
    "feature5": "\u0628\u062f\u0648\u0646 \u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0648\u0645\u0641\u062a\u0648\u062d \u0627\u0644\u0645\u0635\u062f\u0631",
